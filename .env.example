# ============================================
# StockFlow — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control!
# ============================================

# ── PostgreSQL Database ──────────────────
POSTGRES_DB=stockflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_use_a_strong_password

# ── Backend (FastAPI) ────────────────────
DATABASE_URL=postgresql://postgres:changeme_use_a_strong_password@db:5432/stockflow
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite / React) ─────────────
VITE_API_URL=http://localhost:8000

# ── Port Configuration (optional) ───────
# DB_PORT=5433
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
